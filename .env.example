# Supabase 连接信息（复制为 .env 后填入真实值）
SUPABASE_HOST=your-project-ref.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your-password

# 微信小程序配置
WX_APPID=your-wx-appid
WX_SECRET=your-wx-secret

# JWT 密钥（至少 32 字符，无默认值：不配则生产 profile 启动失败）
JWT_SECRET=your-256-bit-secret-key-change-in-production

# 允许跨域的前端来源（逗号分隔；小程序原生请求不需要配）
# 留空 = 不放行任何浏览器跨域；禁止在生产填 * （与 allowCredentials 同时生效不安全）
CORS_ALLOWED_ORIGIN_PATTERNS=

# 接口文档开关（生产保持 false，临时排查才开）
SWAGGER_ENABLED=false

# 微信登录 mock（true 时任意 code 都能换 token，只能本地用）
WX_MOCK_LOGIN=false
